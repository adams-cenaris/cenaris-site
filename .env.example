# Cenaris Chat — Environment Variables
# Set these in the Vercel project dashboard (Settings → Environment Variables)
# Do NOT commit actual values to git.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase — create project in Sydney region (ap-southeast-2)
# https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (never expose client-side)

# Admin console
ADMIN_PASSWORD=choose-a-strong-password-here
JWT_SECRET=generate-with-openssl-rand-hex-32

# Resend — https://resend.com/api-keys (already used for form emails)
RESEND_API_KEY=re_...

# Admin notifications — email
# Address that receives notification emails (defaults to info@cenaris.com.au if unset)
ADMIN_NOTIFICATION_EMAIL=info@cenaris.com.au
# Optional: override the From address on notification emails
# EMAIL_FROM=Cenaris Chat <noreply@cenaris.com.au>

# Admin notifications — OneSignal web push
# Create a Web Push app at https://app.onesignal.com → New App → Web Push
# App ID is safe to expose client-side (used by the browser SDK).
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# REST API Key is a server secret — never expose to the browser.
# Found in OneSignal dashboard → Settings → Keys & IDs → REST API Key
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
