# Cenaris — Analytics configuration reference
#
# This is a static HTML site with no build system.
# These values are NOT actual environment variables —
# they are set directly in assets/analytics.js.
#
# IDs are set in assets/analytics.js:
#   const _GA4_ID     = 'G-JRRFYW0XYY';
#   const _CLARITY_ID = 'wvzpun60gq';
#
# How to find your IDs:
#
# GA4_MEASUREMENT_ID
#   Format:  G-XXXXXXXXXX
#   Location: Google Analytics → Admin → Data streams → your web stream → Measurement ID
#
# CLARITY_PROJECT_ID
#   Format:  10-character alphanumeric string
#   Location: Microsoft Clarity → Settings → Overview → Project ID
#
# ─── Optional future integrations ────────────────────────────────────────────
#
# GOOGLE_TAG_MANAGER_ID
#   Format:  GTM-XXXXXXX
#   Use this instead of the direct GA4 snippet if you move to GTM.
#
# RESEND_API_KEY
#   Stored in Google Apps Script project settings (NOT in this file).
#   Apps Script: Project Settings → Script Properties → RESEND_API_KEY
