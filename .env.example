# Cenaris Chat — Environment Variables
# Set these in the Vercel project dashboard (Settings → Environment Variables)
# Do NOT commit actual values to git.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase — create project in Sydney region (ap-southeast-2)
# https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (never expose client-side)

# Admin console
ADMIN_PASSWORD=choose-a-strong-password-here
JWT_SECRET=generate-with-openssl-rand-hex-32

# Resend — https://resend.com/api-keys (already used for form emails)
RESEND_API_KEY=re_...
